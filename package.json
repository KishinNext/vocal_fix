{
  "name": "vocalfix",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "whisper:build": "node scripts/build-whisper.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.3",
    "@vitest/browser": "^4.1.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11",
    "whisper-node": "^1.1.1"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "^3.21.1"
  },
  "description": "Dictado local con corrección gramatical, sin conexión.",
  "author": "KishinNext",
  "build": {
    "appId": "com.kishinnext.vocalfix",
    "productName": "VocalFix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "VocalFix usa el micrófono para transcribir lo que dictas, sin enviar audio fuera de tu equipo."
      },
      "extraResources": [
        {
          "from": "node_modules/whisper-node/lib/whisper.cpp",
          "to": "whisper",
          "filter": [
            "server",
            "ggml-metal.metal"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.png",
      "extraResources": [
        {
          "from": "node_modules/whisper-node/lib/whisper.cpp/build/bin/Release",
          "to": "whisper",
          "filter": [
            "server.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VocalFix-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "KishinNext",
      "repo": "vocal_fix"
    }
  }
}
